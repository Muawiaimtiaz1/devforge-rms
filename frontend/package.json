{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:analytics-css": "tailwindcss -c analytics.tailwind.cjs -i src/modules/analytics/analytics.source.css -o src/modules/analytics/analytics.generated.css --minify",
    "predev": "npm run build:analytics-css && npm run build:pos-css",
    "prebuild": "npm run build:analytics-css && npm run build:pos-css",
    "test:analytics": "node tests/analytics-parity.cjs",
    "test:tip-filter": "node tests/tip-date-filter.cjs",
    "build:pos-css": "tailwindcss -c pos.tailwind.cjs -i src/modules/pos/pos.source.css -o src/modules/pos/pos.generated.css --minify"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tailwindcss": "^3.4.17",
    "vite": "^8.2.2"
  }
}
