# Database mode (PostgreSQL is required on Vercel)
DB_CLIENT=postgres

# Prefer a single hosted connection string on Vercel.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# PostgreSQL Connection Details
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=1234

# SSL Configuration (Uncomment if using a cloud DB like Supabase or Neon)
# PGSSLMODE=require
# PGSSL_REJECT_UNAUTHORIZED=false

# App Settings
PORT=4000
SESSION_SECRET=replace-with-a-long-random-secret
# Set true behind a trusted single reverse proxy such as Render.
TRUST_PROXY=false
# Production HTTPS deployments should keep this true.
SESSION_COOKIE_SECURE=false
# Optional comma-separated additional trusted browser origins.
CSRF_ALLOWED_ORIGINS=
# Session lifetime in milliseconds (default: 24 hours).
SESSION_MAX_AGE_MS=86400000
# Private persistent directory outside public/. Required for staff documents in production.
STAFF_DOCUMENT_STORAGE_DIR=./storage/staff-documents
