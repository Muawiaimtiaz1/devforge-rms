# Database mode (PostgreSQL is required on Vercel)
DB_CLIENT=postgres

# Prefer a single hosted connection string on Vercel.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# PostgreSQL Connection Details
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=1234

# SSL Configuration (Uncomment if using a cloud DB like Supabase or Neon)
# PGSSLMODE=require
# PGSSL_REJECT_UNAUTHORIZED=false

# App Settings
PORT=4000
SESSION_SECRET=replace-with-a-long-random-secret
#
